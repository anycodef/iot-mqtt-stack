# =============================================================================
# Environment configuration for the IoT MQTT stack
# Copy this file to `.env` and adjust the values for your machine.
#   cp .env.example .env
# `.env` is git-ignored and must NEVER be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Data path — where all persistent volumes live.
#   * Raspberry Pi 4: point this at a mounted USB SSD to avoid SD-card wear,
#     e.g. DATA_PATH=/mnt/ssd/iot-data
#   * Arch / x86_64 dev machine: the default ./data is fine.
# -----------------------------------------------------------------------------
DATA_PATH=./data

# -----------------------------------------------------------------------------
# Timezone applied to all containers (affects log timestamps and Grafana).
# -----------------------------------------------------------------------------
TZ=America/Lima

# -----------------------------------------------------------------------------
# InfluxDB 1.8 — auto-created database for the lab.
# Matches the guide's schema: database `iot_lab`, measurement `sensor_dht22`.
# -----------------------------------------------------------------------------
INFLUXDB_DB=iot_lab

# -----------------------------------------------------------------------------
# Grafana admin credentials (change these before any non-LAN deployment).
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Lab 08 — Google Apps Script web-app endpoint that Node-RED POSTs decrypted
# readings to (appends one row to the Google Sheet). Deploy the script in
# apps-script/Codigo.gs as a web app and paste its /exec URL here.
# -----------------------------------------------------------------------------
APPS_SCRIPT_URL=https://script.google.com/macros/s/PEGAR_ID/exec
