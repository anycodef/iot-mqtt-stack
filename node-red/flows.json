[
  {
    "id": "tab-iot-lab",
    "type": "tab",
    "label": "UNMSM IoT — Grupo g1",
    "disabled": false,
    "info": "Flow 1: telemetry persistence (DHT22 -> InfluxDB).\nFlow 2: gas alarm automation (alarmas/gas -> actuadores/relay).\n\nInside Docker the broker is mosquitto:1883 and InfluxDB is influxdb:8086 (service names)."
  },

  {
    "id": "broker-mosquitto",
    "type": "mqtt-broker",
    "name": "mosquitto",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "node-red-g1",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "willMsg": {},
    "userProps": "",
    "sessionExpiry": ""
  },
  {
    "id": "influx-iot-lab",
    "type": "influxdb",
    "hostname": "influxdb",
    "port": "8086",
    "protocol": "http",
    "database": "iot_lab",
    "name": "influxdb iot_lab",
    "usetls": false,
    "tls": "",
    "influxdbVersion": "1.x",
    "url": "http://influxdb:8086",
    "rejectUnauthorized": true
  },

  {
    "id": "f1-mqtt-in-dht22",
    "type": "mqtt in",
    "z": "tab-iot-lab",
    "name": "sensores/dht22",
    "topic": "unmsm/iot2025/lab-a/g1/sensores/dht22",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "broker-mosquitto",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 100,
    "wires": [["f1-json"]]
  },
  {
    "id": "f1-json",
    "type": "json",
    "z": "tab-iot-lab",
    "name": "parse JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 360,
    "y": 100,
    "wires": [["f1-function"]]
  },
  {
    "id": "f1-function",
    "type": "function",
    "z": "tab-iot-lab",
    "name": "build influx point",
    "func": "var payload = msg.payload;\nmsg.payload = [\n  {\n    measurement: 'sensor_dht22',\n    tags: { dispositivo: payload.dispositivo, aula: 'lab-a', grupo: 'g1' },\n    fields: {\n      temperatura: parseFloat(payload.temperatura),\n      humedad: parseFloat(payload.humedad)\n    }\n  }\n];\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 580,
    "y": 100,
    "wires": [["f1-influx-out", "f1-debug"]]
  },
  {
    "id": "f1-influx-out",
    "type": "influxdb batch",
    "z": "tab-iot-lab",
    "influxdb": "influx-iot-lab",
    "name": "iot_lab",
    "measurement": "",
    "precision": "",
    "retentionPolicy": "",
    "database": "iot_lab",
    "precisionV18FluxV20": "ms",
    "retentionPolicyV18Flux": "",
    "org": "",
    "bucket": "",
    "x": 820,
    "y": 80,
    "wires": []
  },
  {
    "id": "f1-debug",
    "type": "debug",
    "z": "tab-iot-lab",
    "name": "telemetry",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 810,
    "y": 140,
    "wires": []
  },

  {
    "id": "f2-mqtt-in-gas",
    "type": "mqtt in",
    "z": "tab-iot-lab",
    "name": "alarmas/gas",
    "topic": "unmsm/iot2025/lab-a/g1/alarmas/gas",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "broker-mosquitto",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 140,
    "y": 280,
    "wires": [["f2-switch"]]
  },
  {
    "id": "f2-switch",
    "type": "switch",
    "z": "tab-iot-lab",
    "name": "alerta?",
    "property": "payload",
    "propertyType": "msg",
    "rules": [
      { "t": "eq", "v": "ALERT", "vt": "str" },
      { "t": "eq", "v": "1", "vt": "str" },
      { "t": "cont", "v": "alert", "vt": "str" }
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 1,
    "x": 340,
    "y": 280,
    "wires": [["f2-function-on"]]
  },
  {
    "id": "f2-function-on",
    "type": "function",
    "z": "tab-iot-lab",
    "name": "relay ON",
    "func": "msg.payload = \"ON\";\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 540,
    "y": 280,
    "wires": [["f2-mqtt-out-relay", "f2-notify"]]
  },
  {
    "id": "f2-mqtt-out-relay",
    "type": "mqtt out",
    "z": "tab-iot-lab",
    "name": "actuadores/relay",
    "topic": "unmsm/iot2025/lab-a/g1/actuadores/relay",
    "qos": "2",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "broker-mosquitto",
    "x": 770,
    "y": 260,
    "wires": []
  },
  {
    "id": "f2-notify",
    "type": "debug",
    "z": "tab-iot-lab",
    "name": "gas alarm -> relay ON",
    "active": true,
    "tosidebar": true,
    "console": true,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload",
    "statusType": "auto",
    "x": 790,
    "y": 320,
    "wires": []
  }
]
