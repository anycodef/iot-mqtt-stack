!docs/img/
!docs/img/**

# --- Lab 08 ECC keys (never commit the private half) ---
crypto/ecc_privada.pem
firmware/publisher-ecc/ecc_public_key.h

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# --- Local compose overrides (committed only as .example) ---
docker-compose.override.yml

# --- Arduino build output ---
firmware/**/build/
*.bin
*.elf
*.hex
