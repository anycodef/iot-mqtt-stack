# --- Secrets (never commit) ---
.env
firmware/arduino_secrets.h
**/arduino_secrets.h

# --- Runtime data / persisted volumes ---
data/
influxdb/data/
mosquitto/data/
mosquitto/log/

# --- Node-RED runtime artifacts ---
node-red/data/
node-red/.config.*
node-red/.flows.json.backup

